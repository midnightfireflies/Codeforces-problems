#include <iostream>
#include <vector>

using namespace std;

int main()
{
    // Optimize standard I/O operations for speed
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    vector<int> numbers(4);
    for(int i = 0; i < 4; ++i) {
        cin >> numbers[i];
    }
    sort(numbers.begin(), numbers.end());
    int a = numbers[3] - numbers[2];
    int b = numbers[3] - numbers[1];
    int c = numbers[3] - numbers[0];

    cout << a << " " << b << " " << c << "\n";

    return 0;
}
