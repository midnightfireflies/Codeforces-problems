#include <iostream>
#include <vector>
 
 
using namespace std;
 
int main() {
    int n,e=0,o=0,p=0,q=0;
    cin >> n;
 
    vector<int> arr(n);
    for (int i = 0; i < n; ++i) {
        cin >> arr[i];
    }
    for (int i = 0; i < n; ++i) {
        if(arr[i] % 2 != 0) {
            o++;
            p = i+1;
        }
        else{
            e++;
            q = i+1;
        }
    }
    if(o > 1) cout << q << endl;
    else if(e > 1) cout << p << endl;
    return 0;
}
