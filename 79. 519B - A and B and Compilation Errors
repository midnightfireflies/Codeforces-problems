#include <iostream>
#include <vector>
#include <algorithm>

using namespace std;

int main()
{
    // Optimize standard I/O operations for speed
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    long long n,n1=0,n2=0;
    cin >> n;
    vector<long long> number1(n);
    vector<long long> number2(n-1);
    vector<long long> numbers(n-2);
    for (int i = 0; i < n; i++)
    {
        cin >> number1[i];
    }
    for (int i = 0; i < n-1; i++)
    {
        cin >> number2[i];
    }
    for (int i = 0; i < n-2; i++)
    {
        cin >> numbers[i];
    }
    sort(number1.begin(), number1.end());
    sort(number2.begin(), number2.end());
    sort(numbers.begin(), numbers.end());
    n1 = number1[n - 1]; 
    for (int i = 0; i < n-1; i++)
    {
        if (number2[i] != number1[i])
        {
            n1=number1[i];
            break;
        }
    }
    n2 = number2[n - 2];
    for (int i = 0; i < n-2; i++)
    {
        if (numbers[i] != number2[i])
        {
            n2=number2[i];
            break;
        }
    }
    cout << n1 <<' ' << n2 << endl;
    

    return 0;
}
