#include <iostream>
#include <vector>

using namespace std;

int main()
{
    int t;
    cin >> t;
    while (t--)
    {
        int n;
        cin >> n;
        vector<int> arr(n);
        for (int i = 0; i < n; i++)
        {
            cin >> arr[i];
        }
        
        int first = arr[0] % 2;
        bool isSame = true; 

        for (int i = 1; i < n; i++)
        {

            if (arr[i] % 2 != first) 
            {
                isSame = false;
                break;
            }
        }

        if (isSame == true)
            cout << "YES" << endl;
        else
            cout << "NO" << endl;
    }
    return 0;
}
