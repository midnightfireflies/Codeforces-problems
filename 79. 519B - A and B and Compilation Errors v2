#include <iostream>
#include <vector>


using namespace std;

int main()
{
    // Optimize standard I/O operations for speed
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    long long n,n1=0,n2=0, n3=0;
    cin >> n;
    vector<long long> number1(n);
    vector<long long> number2(n-1);
    vector<long long> numbers(n-2);
    for (int i = 0; i < n; i++)
    {
        cin >> number1[i];
    }
    for (int i = 0; i < n-1; i++)
    {
        cin >> number2[i];
    }
    for (int i = 0; i < n-2; i++)
    {
        cin >> numbers[i];
    }
    for (int i = 0; i < n; i++)
    {
        n1 += number1[i];
    }
    for (int i = 0; i < n-1; i++)
    {
        n2 += number2[i];
    }
    for (int i = 0; i < n-2; i++)
    {
        n3 += numbers[i];
    }
    cout << n1 - n2 << ' ' << n2 - n3  << endl;
    return 0;
}
