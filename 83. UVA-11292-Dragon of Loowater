#include <iostream>
#include <vector>
#include <algorithm>

using namespace std;

int main() {
    long long n, m;
    while (cin >> n >> m && (n != 0 || m != 0)) {
        vector<long long> a(n), b(m);
        for(int i = 0; i < n; i++) cin >> a[i];
        for(int i = 0; i < m; i++) cin >> b[i];
        
        sort(a.begin(), a.end());
        sort(b.begin(), b.end());
        
        long long cost = 0, h = 0, k = 0;
        while(h < n && k < m) {
            if(a[h] <= b[k]) { 
                cost += b[k];  
                h++;          
                k++;         
            } else {
                k++;         
            }
        }
        
        if (h == n) cout << cost << endl;
        else cout << "Loowater is doomed!" << endl;
    }
    return 0;
}
