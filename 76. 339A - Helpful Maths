#include <stdio.h>
#include <string.h>
 
int main() {
    char s[105];
    scanf("%s", s);
 
    int count1 = 0, count2 = 0, count3 = 0;
    int len = strlen(s);
 
    // 1. Count how many 1s, 2s, and 3s there are
    for (int i = 0; i < len; i += 2) {
        if (s[i] == '1') count1++;
        else if (s[i] == '2') count2++;
        else if (s[i] == '3') count3++;
    }
 
    // 2. Put '1's, '2's, and '3's back into the string at indices 0, 2, 4...
    int idx = 0;
 
    while (count1--) { s[idx] = '1'; idx += 2; }
    while (count2--) { s[idx] = '2'; idx += 2; }
    while (count3--) { s[idx] = '3'; idx += 2; }
 
    // 3. Print the modified string directly
    printf("%s\n", s);
 
    return 0;
}
