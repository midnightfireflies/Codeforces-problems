#include <iostream>
#include <vector>
#include <string>

using namespace std;

int main()
{
    // Optimize standard I/O operations for speed
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int n, m, steps = 0;
    cin >> n >> m;
    while (m > n)
    {
        if (m % 2 != 0)
        {
            m++;
        }
        else
        {
            m /= 2;
        }
        steps++;
    }
    steps += (n - m);

    cout << steps << "\n";

    return 0;
}
